# ─────────────────────────────────────────────────────────────
# CampusOne — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The app runs fully with the LOCAL defaults below (no cloud account needed).
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas or local/Docker Mongo) ──
# Local/Docker:  mongodb://127.0.0.1:27017/campusone
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/campusone
MONGODB_URI=mongodb://127.0.0.1:27017/campusone

# ── Auth provider: 'local' (JWT issued here) or 'cognito' ──
AUTH_PROVIDER=local

# Local JWT settings (used when AUTH_PROVIDER=local)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS (only needed for Cognito auth and/or S3 storage) ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito (used when AUTH_PROVIDER=cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── File storage: 'local' (disk) or 's3' ──
# Falls back to 'local' automatically if S3 isn't fully configured.
STORAGE_DRIVER=local
S3_BUCKET=
# Optional CloudFront/public base URL for building object URLs
S3_PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Seed demo data automatically on first boot (handy for cloud deploys)
SEED_ON_START=false
