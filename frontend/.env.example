# ─────────────────────────────────────────────────────────────
# CampusOne — Frontend environment variables (Vite)
# Copy this file to `.env` (or `.env.local`) and fill in values.
# In LOCAL DEV you can leave these blank: vite.config.js proxies
# /api and /socket.io to the backend at http://localhost:5000.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secret keys here — anything here ships to the client.
# ─────────────────────────────────────────────────────────────

# Backend REST API base URL, INCLUDING the trailing /api.
# Dev:  leave blank (uses the Vite proxy → /api)
# Prod: https://api.campusone.example.com/api
VITE_API_URL=

# Socket.IO backend origin (NO /api path).
# Dev:  leave blank (same origin via the Vite proxy)
# Prod: https://api.campusone.example.com
VITE_SOCKET_URL=

# OPTIONAL — Google Maps JavaScript API key.
# The campus map works fully WITHOUT this using a built-in schematic
# fallback, so a key is not required. If you add one, restrict it by
# HTTP referrer in the Google Cloud console.
# VITE_GOOGLE_MAPS_API_KEY=
